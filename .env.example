# Base de datos (por defecto apunta a Docker Compose local; para Supabase usar el pooler/host de Supabase)
SAMP_DB_URL=jdbc:postgresql://localhost:5432/samp
SAMP_DB_USERNAME=samp
SAMP_DB_PASSWORD=samp_local_dev

# Ejemplo Supabase (Project ref: fwdjrtmmiqsurxgeruee, us-east-1):
# SAMP_DB_URL=jdbc:postgresql://db.fwdjrtmmiqsurxgeruee.supabase.co:5432/postgres?sslmode=require
# SAMP_DB_USERNAME=postgres
# SAMP_DB_PASSWORD=<tu-password-de-supabase>

# Proveedor de IA (mock | gemini)
SAMP_AI_PROVIDER=mock
SAMP_AI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Seguridad y servidor
SERVER_PORT=8080
SAMP_DEFAULT_CURRENCY=COP
SAMP_DEFAULT_LOCALE=es-CO

# Perfil consola (ruta de archivos JSON)
SAMP_DATA_DIR=./data-json
